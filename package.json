{
  "name": "dsh-remote-assist-lan",
  "version": "1.0.0",
  "description": "局域网 DSH 远程协助/监督/合作插件：设备代码+别名、永久/临时密码直连、异账号弹窗授权、双向文件传输、一键远程装插件；无需公网中继。",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "remote-assistance",
    "remote-support",
    "lan",
    "file-transfer",
    "cordis"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "MIT"
}
